# ─────────────────────────────────────────────────────────────────────────────
# Shopee MCP — Environment Variables
#
# Unlike a plain scraper, this server drives a real Chromium profile so it can
# clear Shopee's anti-bot gate. You log in ONCE with `npm run login`; the session
# is saved to the profile dir below and reused. Everything here is optional.
# ─────────────────────────────────────────────────────────────────────────────

# Shopee regional domain (default: shopee.co.id)
SHOPEE_DOMAIN=shopee.co.id

# Where the persistent Chromium profile (your saved login) lives.
# Default: ~/.shopee-mcp/chrome-profile
# SHOPEE_PROFILE_DIR=/home/you/.shopee-mcp/chrome-profile

# The browser runs HEADED by default because Shopee detects headless — keep it
# that way. On a server, provide a virtual display via `xvfb-run`. Setting this
# to "true" is for experiments only and will almost certainly be blocked.
SHOPEE_HEADLESS=false

# Cache lifetime in milliseconds (default: 30000 = 30s)
CACHE_TTL_MS=30000

# ─── Seller Centre realm ─────────────────────────────────────────────────────
# The portal (seller.<SHOPEE_DOMAIN>) reuses this same browser profile by
# default — a logged-in seller account on the marketplace usually SSOs in.
# Point this at a separate directory only if you want the seller realm isolated.
# SHOPEE_SELLER_PROFILE_DIR=/home/you/.shopee-mcp/seller-profile

# ─── Account-safety gate (anti-ban) ──────────────────────────────────────────
# All browser traffic funnels through one gate: jittered spacing, hourly/daily
# budgets, and an anti-bot circuit breaker. Defaults are the "balanced" profile.
# SHOPEE_READ_SPACING_MS=3000       # + random 0..SHOPEE_READ_SPREAD_MS
# SHOPEE_READ_SPREAD_MS=3000
# SHOPEE_WRITE_SPACING_MS=60000     # + random 0..SHOPEE_WRITE_SPREAD_MS
# SHOPEE_WRITE_SPREAD_MS=120000
# SHOPEE_READ_MAX_PER_HOUR=30
# SHOPEE_WRITE_MAX_PER_HOUR=10
# SHOPEE_WRITE_MAX_PER_DAY=30
# SHOPEE_COOLDOWN_MS=600000         # anti-bot cooldown (10 min)

# Seller-side write actions (price/stock edits, video upload, chat replies)
# stay DISABLED until you explicitly enable them. Buyer-realm reads and the
# Shopee Video probe are unaffected.
SHOPEE_ENABLE_SELLER_WRITES=false

# UI write-action tuning (uploads, stock/price edits). All optional.
# SHOPEE_ACTION_TIMEOUT_MS=60000
# SHOPEE_ACTION_DELAY_MS=2000

# Upload guard: reject videos larger than this many MB before touching the portal.
# SHOPEE_VIDEO_MAX_MB=200

# Set to "true" to log startup/debug info to stderr
DEBUG=false
